# ─── BookStore — environment reference ────────────────────────────────
# Copy this file to .env and fill in real values before running the app.
# `npm run dev` / `npm run build` will auto-generate AUTH_SECRET and
# CRON_SECRET into .env if they are missing (see scripts/ensure-secrets.mjs),
# so only DATABASE_URL is strictly required to get started locally.
#
# The app degrades gracefully when optional integrations are absent —
# e.g. without Stripe keys, checkout clearly reports "payments not
# configured" instead of pretending a payment succeeded.

# ── Required ────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# JWT signing secret for session cookies & signed eBook download URLs.
# Auto-generated into .env on first `npm run dev`/`build` if left blank.
AUTH_SECRET=

# Secret used to authorize the /api/maintenance/cleanup cron endpoint.
# Auto-generated into .env on first `npm run dev`/`build` if left blank.
CRON_SECRET=

# ── Optional — eBook downloads ──────────────────────────────────────
# Dedicated key for signing eBook download links (falls back to AUTH_SECRET
# when unset). Rotating this invalidates outstanding download links without
# logging users out.
DOWNLOAD_SIGNING_SECRET=

# Sales tax rate as a fraction (e.g. 0.0825 for 8.25%). Defaults to 0.
# Applied server-side to the discounted goods total — never trust a
# client-submitted tax amount.
TAX_RATE=

# ── Optional — Authentication providers ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional — Payments (Stripe) ────────────────────────────────────
# When these are absent in development, checkout runs a clearly-labelled
# test mode using the same idempotent order-confirmation path the real
# webhook uses. In production, a missing STRIPE_SECRET_KEY makes checkout
# return HTTP 503 rather than ever auto-confirming an order.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Optional — Public book cover CDN ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional — Private eBook object storage (signed URLs only) ─────
# Never point these at a publicly-readable bucket/folder.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# ── Optional — Transactional email (log-only mode when absent) ─────
RESEND_API_KEY=
EMAIL_FROM="BookStore <no-reply@example.com>"

# ── Optional — Error telemetry ──────────────────────────────────────
SENTRY_DSN=
